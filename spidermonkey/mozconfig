# SpiderMonkey for NightMonkey: the JS shell built for wasm32-wasi with the
# external compiler hook surface, private-header export and the `jsshell`
# static library enabled, and wizer snapshot support in the shell. Build from
# the SpiderMonkey checkout:
#
#   MOZCONFIG=/path/to/nightmonkey/spidermonkey/mozconfig ./mach build
#
# Everything NightMonkey consumes lands under obj-nightmonkey-sm/dist:
# include/ and include-private/ (headers, js-build-config.json), lib/ (the
# archives), and bin/js (the plain wasm shell, used for the interpreter-only lane).
ac_add_options --enable-project=js
ac_add_options --target=wasm32-unknown-wasi
ac_add_options --enable-js-shell
ac_add_options --enable-js-shell-wizer
ac_add_options --enable-external-compiler-hooks
ac_add_options --disable-stdcxx-compat
ac_add_options --without-system-zlib
ac_add_options --without-intl-api
ac_add_options --disable-jit
ac_add_options --disable-shared-js
ac_add_options --disable-shared-memory
ac_add_options --disable-tests
ac_add_options --disable-clang-plugin
ac_add_options --disable-debug-symbols
ac_add_options --enable-optimize
ac_add_options --enable-jitspew

mk_add_options MOZ_OBJDIR=obj-nightmonkey-sm
mk_add_options AUTOCLOBBER=1

export RUSTFLAGS="-Cdebuginfo=0"
